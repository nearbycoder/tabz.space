{
	"manifest_version": 3,
	"name": "Tabz — save to your start page",
	"short_name": "Tabz",
	"description": "Add the page you're on to tabz.space in one click, and make tabz your new tab page.",
	"version": "0.1.0",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "Add to tabz",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": { "service_worker": "background.js", "type": "module" },
	"permissions": ["activeTab", "contextMenus", "storage"],
	"chrome_url_overrides": { "newtab": "newtab.html" },
	"options_page": "options.html",
	"commands": {
		"_execute_action": {
			"suggested_key": { "default": "Alt+Shift+T" },
			"description": "Add the current page to tabz"
		}
	}
}
