{
	"manifest_version": 3,
	"name": "Tabz \u2014 save to your start page",
	"short_name": "Tabz",
	"description": "Save pages and whole windows of tabs to tabz.space, mirror your browser bookmarks, open private links in incognito, and use tabz as your new tab.",
	"version": "0.3.4",
	"icons": {
		"16": "icons/icon-16.png",
		"32": "icons/icon-32.png",
		"48": "icons/icon-48.png",
		"128": "icons/icon-128.png"
	},
	"action": {
		"default_title": "tabz",
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon-16.png",
			"32": "icons/icon-32.png"
		}
	},
	"background": {
		"service_worker": "background.js",
		"type": "module"
	},
	"permissions": ["activeTab", "contextMenus", "storage", "tabs", "bookmarks"],
	"chrome_url_overrides": {
		"newtab": "newtab.html"
	},
	"options_page": "options.html",
	"commands": {
		"_execute_action": {
			"suggested_key": {
				"default": "Alt+Shift+T"
			},
			"description": "Add the current page to tabz"
		}
	},
	"content_scripts": [
		{
			"matches": [
				"https://tabz.space/*",
				"https://www.tabz.space/*",
				"http://localhost/*"
			],
			"js": ["bridge.js"],
			"run_at": "document_start"
		}
	],
	"host_permissions": ["https://tabz.space/*", "http://localhost/*"]
}
